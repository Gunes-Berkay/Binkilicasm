[Unit]
Description=Binkilic ASM Django Gunicorn Daemon
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/binkilicasm/backend
Environment="PATH=/var/www/binkilicasm/backend/venv/bin"
Environment="DJANGO_DEBUG=False"
Environment="DJANGO_ALLOWED_HOSTS=binkilicasm.com.tr,www.binkilicasm.com.tr,77.245.155.150,127.0.0.1,localhost"
Environment="CORS_ALLOWED_ORIGINS=https://binkilicasm.com.tr,https://www.binkilicasm.com.tr,http://binkilicasm.com.tr,http://www.binkilicasm.com.tr"
ExecStart=/var/www/binkilicasm/backend/venv/bin/gunicorn \
          --workers 3 \
          --bind 127.0.0.1:8000 \
          --timeout 120 \
          asm_backend.wsgi:application

Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
